  {
   "id": 2,
   "type": "table",
   "title": "Firing alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "alertstate": true
      }
     }
    }
   ],
   "options": {
    "showHeader": true
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Control plane (actual / expected OSPF Full)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ft_ospf_full_neighbors - ft_ospf_expected_neighbors",
     "legendFormat": "{{node}} OSPF \u0394"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ft_bgp_established",
     "legendFormat": "{{node}} BGP"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ft_bfd_up",
     "legendFormat": "{{node}} BFD"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 0
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
